# Platform settings. Copy to .env on the server; never commit .env (rule 1).
#
#   cp .env.example .env

# Public addresses, no trailing slash. A staging box renders itself under its
# own names by changing these two lines and nothing else.
# LABS_URL=https://labs.abclegacyllc.com
# MCP_URL=https://mcp.abclegacyllc.com

# Where the mcp service (the gateway behind mcp.abclegacyllc.com) listens.
# Guest projects get their ports assigned by `labs deploy`, starting at 8801.
# GATEWAY_PORT=8800
