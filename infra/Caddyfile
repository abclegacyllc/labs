# Both Labs hostnames. Imported from /etc/caddy/Caddyfile with one line:
#
#     import /home/labs/labs/infra/Caddyfile
#
# After that one root edit, every later change lives in this repo and reaches
# Caddy through `labs render` (which calls `caddy reload` via the local admin
# API — no sudo). Paths assume the deploy checkout is /home/labs/labs.

# ── The catalog — a static directory, no process behind it ─────────────────
labs.abclegacyllc.com {
	root * /home/labs/labs/site/dist
	encode zstd gzip
	file_server
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		-Server
	}
}

# ── The mcp capability — one domain, one auth boundary, one process per project ─
mcp.abclegacyllc.com {
	encode zstd gzip
	header -Server

	# Project routes, generated by `labs render` from var/registry.d: one
	# `handle /<id>*` per project renting mcp. A glob, so an empty directory
	# is not an error. Nobody edits these by hand.
	import /home/labs/labs/var/routes/*.caddy

	# Everything without a project route — the index, /healthz, 410 for retired
	# paths, later /.well-known/* — is the gateway (platform/mcp/server.mjs).
	handle {
		reverse_proxy 127.0.0.1:8800
	}
}
