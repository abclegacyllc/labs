# Rendered by `labs render` into var/Caddyfile — never edit that copy, edit this one.
#
# Everything machine-specific is filled in from where the checkout actually is and
# from registry.json, so this file says nothing about a particular server:
#   {{root}}          the checkout, e.g. /home/abcdev/labs
#   {{labsHost}}      from site.labsUrl
#   {{mcpHost}}       from site.mcpUrl
#   {{gatewayPort}}   GATEWAY_PORT, default 8800
#
# Wire it into the system Caddy once, as root:
#     echo 'import {{root}}/var/Caddyfile' | sudo tee -a /etc/caddy/Caddyfile
#     sudo systemctl reload caddy
# After that, every change reaches Caddy through `labs render`, which reloads it
# over the local admin API — no sudo, ever again.

# ── The catalog — a static directory, no process behind it ─────────────────
{{labsHost}} {
	root * {{root}}/site/dist
	encode zstd gzip
	file_server
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		-Server
	}
}

# ── The mcp capability — one domain, one auth boundary, one process per project ─
{{mcpHost}} {
	encode zstd gzip
	header -Server

	# Project routes, generated by `labs render` from var/registry.d: one
	# `handle /<id>*` per project renting mcp. A glob, so an empty directory
	# is not an error. Nobody edits these by hand.
	import {{root}}/var/routes/*.caddy

	# Everything without a project route — the index, /healthz, 410 for retired
	# paths, later /.well-known/* — is the gateway (platform/mcp/server.mjs).
	handle {
		reverse_proxy 127.0.0.1:{{gatewayPort}}
	}
}
