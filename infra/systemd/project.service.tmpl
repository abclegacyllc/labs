[Unit]
# Written by `labs deploy {{id}}` — edit the template in infra/systemd/, not this copy.
# One project, one process, one port: a crash or redeploy here touches nothing else.
Description=ABC Legacy Labs — project {{id}}
Documentation={{repo}}
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory={{dir}}
# Generated by Labs as plain KEY=value lines, so EnvironmentFile is safe here —
# unlike a hand-written .env, which node and systemd would read differently.
EnvironmentFile={{envfile}}
ExecStart=/bin/sh -c 'exec {{start}}'
NoNewPrivileges=yes
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
