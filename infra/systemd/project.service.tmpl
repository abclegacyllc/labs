[Unit]
# Written by `labs deploy {{id}}` — edit the template in infra/systemd/, not this copy.
# One project, one process, one port: a crash or redeploy here touches nothing else.
Description=ABC Legacy Labs — project {{id}}
Documentation={{repo}}
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory={{dir}}
# Generated by Labs as plain KEY=value lines, so EnvironmentFile is safe here —
# unlike a hand-written .env, which node and systemd would read differently.
EnvironmentFile={{envfile}}
ExecStart=/bin/sh -c 'exec {{start}}'
NoNewPrivileges=yes
# Baseline sandboxing: a guest can write only its own checkout and cannot
# modify the host OS, devices, kernel settings or namespaces. Full home-directory
# confidentiality still requires running guests as a dedicated user/container.
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ReadWritePaths={{dir}}
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
UMask=0077
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
