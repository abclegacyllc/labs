[Unit]
# One run of `labs sync`: re-read every allowlisted repository's abc-labs/labs.json
# from GitHub, re-render the catalog, the pages, index.json and the routes, reload
# Caddy. A project author edits their manifest and pushes; this is how the change
# reaches the catalog without anyone touching the Labs server.
#
# Scheduled by labs-sync.timer — never enabled on its own. `make sync` runs the
# same command by hand.
Description=ABC Legacy Labs — re-read the listings
Documentation=https://github.com/abclegacyllc/labs
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/labs
ExecStart=/usr/bin/node --env-file-if-exists=.env bin/labs.mjs sync

# Unlike the gateway this one writes: var/ (listings, routes, the Caddyfile) and
# site/dist (the catalog). Those two paths, nothing else — and UMask 0022 because
# Caddy, running as another user, has to read what it renders.
NoNewPrivileges=yes
PrivateTmp=yes
# ProtectSystem=strict already mounts the whole hierarchy read-only, home
# included, so these two paths are the only writable ones. (No BindPaths or
# ProtectHome=tmpfs here: both need privileges a user manager does not have —
# the unit fails with 218/CAPABILITIES.)
ProtectSystem=strict
ReadWritePaths=%h/labs/var %h/labs/site/dist
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6
UMask=0022
