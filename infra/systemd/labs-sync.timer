[Unit]
# Nightly, at a random minute in the first hour so a fleet of Labs machines would
# not hit GitHub in the same second. Persistent: a run missed while the machine
# was off happens at the next boot instead of being skipped.
Description=ABC Legacy Labs — nightly listings sync

[Timer]
OnCalendar=*-*-* 03:00:00
RandomizedDelaySec=1h
Persistent=true
Unit=labs-sync.service

[Install]
WantedBy=timers.target
