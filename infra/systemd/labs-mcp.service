[Unit]
# The mcp capability's own process: index, health, 410s, later OAuth discovery.
# A USER unit, like the company map's: with lingering on it starts at boot, and
# `systemctl --user restart labs-mcp` needs no sudo.
Description=ABC Legacy Labs — mcp capability (gateway)
Documentation=https://github.com/abclegacyllc/labs/tree/main/platform/mcp
After=network-online.target
Wants=network-online.target
# Restart on crash (below) but not forever: five failures in five minutes and it stays down, visibly.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/labs
# .env is read by node, not by systemd's EnvironmentFile: one parser, one meaning.
ExecStart=/usr/bin/node --env-file-if-exists=.env platform/mcp/server.mjs

# The gateway reads var/projects/*/realized.json and registry.json and writes nothing at all,
# so it runs with the filesystem read-only and no write path declared. Same set
# as project.service.tmpl gives a guest — the platform should not be the softest
# thing on the machine.
# Two protections a USER manager cannot apply on this kernel — both need
# capabilities systemd cannot drop without privileges, and the unit dies with
# 218/CAPABILITIES: PrivateDevices= and ProtectKernelModules=. Do not add them
# back without starting the unit and reading its status.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6
UMask=0077

Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
