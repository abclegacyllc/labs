# Secrets. The only place a value lives is .env (platform) or var/projects/<id>/env
# (written by `labs deploy`); every committed file refers to a secret by name.
.env
.env.*
!.env.example

# Realized state — what is actually deployed on THIS machine. Never shared via git:
#   var/projects/<id>/   EVERYTHING about one project: realized.json (listing), repo/, env, its unit
#   var/routes/*.caddy   generated from all projects
var/

# Build output — regenerated by `labs render`.
site/dist/

# Runtime
node_modules/
*.log

# Editors / OS
.DS_Store
.vscode/
.idea/
