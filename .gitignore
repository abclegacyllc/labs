# Secrets. The only place a value lives is .env (platform) or var/env/<id>.env
# (written by `labs deploy`); every committed file refers to a secret by name.
.env
.env.*
!.env.example

# Realized state — what is actually deployed on THIS machine. Never shared via git:
#   var/projects/<id>/   guest checkouts      var/registry.d/<id>.json   listings
#   var/routes/*.caddy   generated routes     var/env/<id>.env           injected env
var/

# Build output — regenerated by `labs render`.
site/dist/

# Runtime
node_modules/
*.log

# Editors / OS
.DS_Store
.vscode/
.idea/
